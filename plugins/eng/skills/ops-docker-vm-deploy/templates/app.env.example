# Runtime environment template. This file ships in git; the real one does not.
# Real file: /opt/<APP>/app.env — chmod 600, typed on the server, never committed.
#
# Values here are read when the container starts. Anything inlined into a shipped
# bundle at build time belongs in the workflow's build-args instead — setting it
# here has no effect and the failure is silent.

# Required. The app exits at startup without it.
DATABASE_URL=

# Required. Rotating it coordinates with whoever calls the API.
API_KEY=

# Optional. Defaults exist in code.
LOG_LEVEL=info
